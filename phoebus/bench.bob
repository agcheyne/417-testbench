<widget type="label" version="2.0.0"><name>label_709</name><x>622</x><y>738</y><width>826</width><height>22</height><text>Controls</text><font><font family="Liberation Sans" style="BOLD" size="13.0"/></font><foreground_color><color red="60" green="70" blue="90"/></foreground_color><horizontal_alignment>0</horizontal_alignment><vertical_alignment>1</vertical_alignment></widget>
<widget type="rectangle" version="2.0.0"><name>lock_box</name><x>622</x><y>760</y><width>330</width><height>36</height><background_color><color red="120" green="120" blue="120"/></background_color><line_width>0</line_width><corner_width>6</corner_width><corner_height>6</corner_height><rules><rule name="unl" prop_id="background_color" out_exp="false"><exp bool_exp="pv0==1"><value><color red="255" green="190" blue="60"/></value></exp><pv_name>loc://unlocked$(DID)&lt;VLong&gt;(0)</pv_name></rule></rules><scripts><script file="EmbeddedPy"><text><![CDATA[# Relock script of the bench panel (embedded into bench.bob by make_bench_panel.py; Jython).
# PVs: 0 loc://unlocked$(DID), 1 a 1 s ticker, 2 loc://relock_left$(DID), 3 loc://last_write$(DID).
# The window locks again 5 min after unlocking or after the last write, whichever is later. The
# writes are seen by the touch scripts (touch.py), one per IOC, which put the time of any setpoint
# change into loc://last_write$(DID): Phoebus runs a script only once all its PVs are connected, so
# one IOC being down must not stop the relock. Any window's write counts: the setpoints are shared.
from org.csstudio.display.builder.runtime.script import PVUtil
import time

RELOCK_S = 300
now = time.time()
try:
    unlocked = PVUtil.getLong(pvs[0]) == 1
except Exception:
    unlocked = False
try:
    last_write = PVUtil.getDouble(pvs[3])
except Exception:
    last_write = 0.0
was = widget.getUserData("relock_was")
since = widget.getUserData("relock_since") or 0.0
if unlocked and not was:
    since = now
widget.setUserData("relock_since", since)
widget.setUserData("relock_was", unlocked)
left = 0
if unlocked:
    left = int(RELOCK_S - (now - max(since, last_write)))
    if left <= 0:
        left = 0
        pvs[0].write(0)
pvs[2].write(left)
]]></text><pv_name trigger="true">loc://unlocked$(DID)&lt;VLong&gt;(0)</pv_name><pv_name trigger="true">sim://ramp(0,1000000,1,1)</pv_name><pv_name trigger="false">loc://relock_left$(DID)&lt;VLong&gt;(0)</pv_name><pv_name trigger="false">loc://last_write$(DID)&lt;VDouble&gt;(0)</pv_name></script><script file="EmbeddedPy"><text><![CDATA[# Touch script of the bench panel (embedded by make_bench_panel.py; Jython): any change of its
# setpoint PVs (1...) puts the time into PV 0, loc://last_write$(DID), for relock.py.
import time
pvs[0].write(time.time())
]]></text><pv_name trigger="false">loc://last_write$(DID)&lt;VDouble&gt;(0)</pv_name><pv_name trigger="true">N1470_A:CH0:VSET_SP</pv_name><pv_name trigger="true">N1470_A:CH0:ISET_SP</pv_name><pv_name trigger="true">N1470_A:CH0:RUP_SP</pv_name><pv_name trigger="true">N1470_A:CH0:RDW_SP</pv_name><pv_name trigger="true">N1470_A:CH0:TRIP_SP</pv_name><pv_name trigger="true">N1470_A:CH0:PDWN_SP</pv_name><pv_name trigger="true">N1470_A:CH1:VSET_SP</pv_name><pv_name trigger="true">N1470_A:CH1:ISET_SP</pv_name><pv_name trigger="true">N1470_A:CH1:RUP_SP</pv_name><pv_name trigger="true">N1470_A:CH1:RDW_SP</pv_name><pv_name trigger="true">N1470_A:CH1:TRIP_SP</pv_name><pv_name trigger="true">N1470_A:CH1:PDWN_SP</pv_name><pv_name trigger="true">N1470_A:CH2:VSET_SP</pv_name><pv_name trigger="true">N1470_A:CH2:ISET_SP</pv_name><pv_name trigger="true">N1470_A:CH2:RUP_SP</pv_name><pv_name trigger="true">N1470_A:CH2:RDW_SP</pv_name><pv_name trigger="true">N1470_A:CH2:TRIP_SP</pv_name><pv_name trigger="true">N1470_A:CH2:PDWN_SP</pv_name><pv_name trigger="true">N1470_A:CH3:VSET_SP</pv_name><pv_name trigger="true">N1470_A:CH3:ISET_SP</pv_name><pv_name trigger="true">N1470_A:CH3:RUP_SP</pv_name><pv_name trigger="true">N1470_A:CH3:RDW_SP</pv_name><pv_name trigger="true">N1470_A:CH3:TRIP_SP</pv_name><pv_name trigger="true">N1470_A:CH3:PDWN_SP</pv_name><pv_name trigger="true">N1470_B:CH0:VSET_SP</pv_name><pv_name trigger="true">N1470_B:CH0:ISET_SP</pv_name><pv_name trigger="true">N1470_B:CH0:RUP_SP</pv_name><pv_name trigger="true">N1470_B:CH0:RDW_SP</pv_name><pv_name trigger="true">N1470_B:CH0:TRIP_SP</pv_name><pv_name trigger="true">N1470_B:CH0:PDWN_SP</pv_name><pv_name trigger="true">N1470_B:CH1:VSET_SP</pv_name><pv_name trigger="true">N1470_B:CH1:ISET_SP</pv_name><pv_name trigger="true">N1470_B:CH1:RUP_SP</pv_name><pv_name trigger="true">N1470_B:CH1:RDW_SP</pv_name><pv_name trigger="true">N1470_B:CH1:TRIP_SP</pv_name><pv_name trigger="true">N1470_B:CH1:PDWN_SP</pv_name><pv_name trigger="t