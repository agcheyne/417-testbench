# Environment of the bench's systemd user services (EnvironmentFile=). With linger they start at boot,
# before (or without) any login, so nothing from a login shell is there: rcdaq, EPICS and the CA
# addresses are given here. Only for the services that run rcdaq or CA clients.
PATH=/home/nptest/softwarerepo/install/bin:/home/nptest/epics/base/bin/linux-x86_64:/usr/local/bin:/usr/bin:/bin
LD_LIBRARY_PATH=/home/nptest/softwarerepo/install/lib:/home/nptest/epics/base/lib/linux-x86_64:/home/nptest/epics/extensions/lib/linux-x86_64
EPICS_CA_AUTO_ADDR_LIST=NO
EPICS_CA_ADDR_LIST=localhost localhost:5070 localhost:5072
EPICS_CA_MAX_ARRAY_BYTES=600000
