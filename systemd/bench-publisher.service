# DAQ / scan status and the HV channel config for the bench panel: bin/bench_publisher.sh
# (docs/epics.md). Install as hv-annunciator.service.
[Unit]
Description=Bench panel publisher (rcdaq, scans, hv.conf -> N1470 IOC soft records)
Wants=ioc-n1470.service
After=ioc-n1470.service rcdaq-server.service

[Service]
Type=simple
EnvironmentFile=%h/417-testbench/systemd/bench.env
ExecStart=%h/417-testbench/bin/bench_publisher.sh
Restart=always
RestartSec=10

[Install]
WantedBy=default.target
