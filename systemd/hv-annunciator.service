# The HV alarm annunciator (docs/epics.md): bin/hv_annunciator.sh, reading the N1470 IOC's alarms.
# Install (with the IOC services, docs/epics.md):
#   cp hv-annunciator.service ~/.config/systemd/user/ && systemctl --user daemon-reload
#   systemctl --user enable --now hv-annunciator.service
[Unit]
Description=HV alarm annunciator (hv_annunciator.sh)
Wants=ioc-n1470.service
After=ioc-n1470.service ioc-pilas.service

[Service]
Type=simple
EnvironmentFile=%h/417-testbench/systemd/bench.env
ExecStart=%h/417-testbench/bin/hv_annunciator.sh
Restart=always
RestartSec=10

[Install]
WantedBy=default.target
